# SQLite only in this baseline; path is relative to repository root.
DATABASE_URL=file:./.data/octoagent.sqlite
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Production requires HTTPS and sets Secure session cookies.
NODE_ENV=development

# Private BLOB storage limits; extensions must be a subset of the server whitelist.
FILE_MAX_BYTES=10485760
FILE_MAX_COUNT=20
FILE_EXTENSIONS=.ts,.json,.md,.txt,.zip

# Trusted deployment configuration only; install ClamAV and a current local signature DB.
# No shell or client-provided options. Missing dependencies fail closed.
CLAMAV_EXECUTABLE=/usr/bin/clamscan
CLAMAV_TIMEOUT_MS=30000
