{
  "name": "octoagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.1 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.{ts,json,md,yml,html,css}'",
    "format:check": "prettier --check '**/*.{ts,json,md,yml,html,css}'",
    "dev": "npm run build && node --env-file-if-exists=.env dist/apps/server/src/main.js",
    "start": "node --env-file-if-exists=.env dist/apps/server/src/main.js",
    "db:migrate": "npm run build && node --env-file-if-exists=.env dist/packages/database/src/migrate.js",
    "db:check": "node --test dist/tests/database.test.js",
    "test": "node --test dist/tests/*.test.js",
    "check": "bash scripts/check.sh",
    "demo:seed": "npm run build && node dist/packages/demo/src/main.js",
    "test:e2e": "npm run build && node --test dist/tests/e2e.test.js"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "prettier": "1.19.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  }
}
